<Window
    x:Class="XamlFeatureTest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:XamlFeatureTest"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="XAML Feature Test"
    Width="900"
    Height="700"
    d:DesignWidth="900"
    d:DesignHeight="700">
	<!-- ===================== -->
	<!-- Resources Section     -->
	<!-- ===================== -->
	<Window.Resources>
		<!-- Primitive resources -->
		<sys:String x:Key="GreetingText">Hello XAML</sys:String>
		<sys:Int32 x:Key="DefaultPadding">8</sys:Int32>
		<!-- x:Array -->
		<x:Array x:Key="StringArray" Type="{x:Type sys:String}">
			<sys:String>One</sys:String>
			<sys:String>Two</sys:String>
			<sys:String>Three</sys:String>
		</x:Array>
		<!-- Converter -->
		<local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
		<!-- ObjectDataProvider -->
		<ObjectDataProvider
            x:Key="NowProvider"
            MethodName="Now"
            ObjectType="{x:Type sys:DateTime}" />
		<!-- Style with BasedOn -->
		<Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
			<Setter Property="Margin" Value="4" />
			<Setter Property="FontSize" Value="14" />
		</Style>
		<Style
            x:Key="DerivedTextBlockStyle"
            TargetType="TextBlock"
            BasedOn="{StaticResource BaseTextBlockStyle}">
			<Setter Property="Foreground" Value="DarkBlue" />
		</Style>
		<!-- ControlTemplate -->
		<ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
			<Border
                Background="{TemplateBinding Background}"
                CornerRadius="6"
                Padding="6">
				<ContentPresenter HorizontalAlignment="Center" />
			</Border>
		</ControlTemplate>
		<!-- DataTemplate -->
		<DataTemplate x:Key="PersonTemplate">
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="{Binding FirstName}" />
				<TextBlock Text=" " />
				<TextBlock Text="{Binding LastName}" />
			</StackPanel>
		</DataTemplate>
	</Window.Resources>
	<!-- ===================== -->
	<!-- Root Layout           -->
	<!-- ===================== -->
	<Grid x:Name="RootGrid">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<!-- Property element syntax -->
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="2*" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<!-- ===================== -->
		<!-- Attached properties   -->
		<!-- ===================== -->
		<DockPanel Grid.Row="0" Grid.ColumnSpan="2" LastChildFill="True">
			<TextBlock
                DockPanel.Dock="Left"
                Style="{DynamicResource DerivedTextBlockStyle}"
                Text="{StaticResource GreetingText}" />
			<TextBlock
                DockPanel.Dock="Right"
                Text="{Binding Source={StaticResource NowProvider}}"/>
		</DockPanel>
		<!-- ===================== -->
		<!-- Bindings & Markup     -->
		<!-- ===================== -->
		<StackPanel Grid.Row="1" Grid.Column="0" Margin="{StaticResource DefaultPadding}">
			<!-- Simple Binding -->
			<TextBox
                x:Name="InputBox"
                Text="{Binding UserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
			<!-- FallbackValue & TargetNullValue -->
			<TextBlock
                Text="{Binding OptionalText,
                               FallbackValue='Fallback',
                               TargetNullValue='Null'}" />
			<!-- MultiBinding -->
			<TextBlock>
				<TextBlock.Text>
					<MultiBinding StringFormat="{}{0} {1}">
						<Binding Path="FirstName" />
						<Binding Path="LastName" />
					</MultiBinding>
				</TextBlock.Text>
			</TextBlock>
			<!-- x:Reference -->
			<TextBlock
                Text="{Binding Text, Source={x:Reference InputBox}}" />
			<!-- Converter -->
			<CheckBox x:Name="Check" Content="Show Button" />
			<Button
                Content="Conditional Button"
                Visibility="{Binding IsChecked,
                                     ElementName=Check,
                                     Converter={StaticResource BoolToVisibility}}" />
			<!-- Command -->
			<Button
                Content="Execute Command"
                Command="{Binding SaveCommand}" />
		</StackPanel>
		<!-- ===================== -->
		<!-- Templates & Triggers  -->
		<!-- ===================== -->
		<StackPanel Grid.Row="1" Grid.Column="1">
			<Button
                Content="Styled Button"
                Background="LightGray"
                Template="{StaticResource RoundedButtonTemplate}">
				<!-- Triggers -->
				<Button.Triggers>
					<EventTrigger RoutedEvent="Button.Click">
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
                                    Storyboard.TargetProperty="Opacity"
                                    To="0.5"
                                    Duration="0:0:0.2" />
							</Storyboard>
						</BeginStoryboard>
					</EventTrigger>
				</Button.Triggers>
			</Button>
			<!-- ItemsControl + DataTemplate -->
			<ItemsControl
                ItemsSource="{Binding People}"
                ItemTemplate="{StaticResource PersonTemplate}" />
		</StackPanel>
	</Grid>
</Window>
